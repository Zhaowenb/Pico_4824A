[Unit]
Description=WaveGuard Pico4824A and IT6524D workstation
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/docker start --attach waveguard-r76s
ExecStop=/usr/bin/docker stop --time 30 waveguard-r76s
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
